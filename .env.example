# Copy to .env and fill in values for local dev.
# `wrangler dev` reads this file (when no .dev.vars exists) and exposes vars to the worker.
# Production secrets are set via: pnpm exec wrangler secret put VAR_NAME

# Telegram bot for bat-signal notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to true to log incoming message rate to the server console (see party/server.ts).
# Production default lives in wrangler.jsonc `vars`.
# Useful for measuring real client send rates before tuning perf thresholds.
DEBUG=false

# Chromatic project token for Storybook visual testing deploys.
# Get from your Chromatic project dashboard → Manage → Configure.
CHROMATIC_PROJECT_TOKEN=
